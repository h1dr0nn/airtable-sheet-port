{
  "name": "airtable-sheet-port",
  "private": true,
  "version": "0.3.0",
  "description": "Airtable - Sheet Port - Safe local port for AI agents to access tables and spreadsheets.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b --pretty false",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test && pnpm test:e2e",
    "test:e2e": "cargo build -p sheet-port-mcp --features mock && node scripts/e2e-smoke.mjs",
    "test:live": "cargo build --release -p sheet-port-mcp && node scripts/live-smoke.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
